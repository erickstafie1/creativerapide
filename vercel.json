{
  "framework": null,
  "buildCommand": "echo no build needed",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(?:BG)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/bg/",
      "permanent": false
    },
    {
      "source": "/home",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(?:BG)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/bg/",
      "permanent": false
    },
    {
      "source": "/despre",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(?:BG)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/bg/despre",
      "permanent": false
    },
    {
      "source": "/portofoliu",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(?:BG)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/bg/portofoliu",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    }
  ]
}